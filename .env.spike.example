# Copy to .env.spike only if it does not already exist. Never commit real keys.
# Loaded only by the explicitly invoked compatibility runner.
VESPERS_SPIKE_GEMINI_API_KEY=
VESPERS_SPIKE_GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Separate platform-managed Tavily test key.
VESPERS_SPIKE_TAVILY_API_KEY=
# Optional until connected-app onboarding; no live Composio calls in this spike.
VESPERS_SPIKE_COMPOSIO_API_KEY=
VESPERS_SPIKE_COMPOSIO_TEST_USER_ID=
VESPERS_SPIKE_COMPOSIO_TEST_CONNECTED_ACCOUNT_ID=
# Keys alone do not start calls. See docs/provider-compatibility.md for explicit opt-in.
