# Copy to .env.dashboard; that file is Git-ignored and excluded from Docker builds.
# Every value here is read server-side only. Nothing reaches the browser bundle
# (NEXT_PUBLIC_WORKOS_REDIRECT_URI is read by server code only, and is absent from
# the client bundle).
#
# This file is the single source for the WorkOS values below. compose.yaml
# deliberately does not repeat these keys, because a key set in a service's
# `environment:` silently overrides the same key from its `env_file`.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Session-cookie encryption key, 32+ characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match the redirect URI registered in the WorkOS dashboard exactly.
# Plain http is accepted only when VESPERS_ENVIRONMENT is development or test.
# With VESPERS_ENVIRONMENT=production this must be https, including on localhost:
# the AuthKit session cookie is marked Secure from this scheme alone.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Origins accepted on state-changing BFF requests (CSRF).
VESPERS_ALLOWED_ORIGINS=http://localhost:3000
# Host-mode only (`make dev-dashboard`): under Compose the dashboard service sets
# this to the internal service name and that value wins. Use http://localhost:8000
# when running the dashboard directly on your machine.
VESPERS_API_BASE_URL=http://localhost:8000
