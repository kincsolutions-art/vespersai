# Local development only. No live provider keys are needed for scaffold checks.
VESPERS_ENVIRONMENT=development
VESPERS_DATABASE_URL=postgresql+psycopg://vespers_app:local_app_only@127.0.0.1:5433/vespers_development
VESPERS_DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://vespers_dbos:local_dbos_only@127.0.0.1:5433/vespers_dbos_development
VESPERS_LOG_LEVEL=INFO
VESPERS_SIGNUP_ALLOWLIST=[]
# WorkOS AuthKit, backend half. Empty means protected API routes fail closed
# with 503 while /health/live and offline tests keep working.
VESPERS_WORKOS_CLIENT_ID=
VESPERS_WORKOS_API_KEY=
# Accepted `iss` values, JSON list. Leave unset to derive
# https://api.workos.com/user_management/<client_id>, which is what WorkOS
# actually issues (verified against a live token; both documentation pages show
# the bare origin instead, and that value rejects every real token). Set this
# explicitly only for a custom auth domain, reading the value from a decoded
# token. Each entry is accepted with and without a trailing slash.
# VESPERS_WORKOS_ISSUERS=["https://your-domain.example/user_management/client_..."]
# Only set this when a WorkOS JWT template adds an `aud` claim naming this API.
# Leave it empty otherwise: a token that carries an unexpected `aud` is refused.
# VESPERS_WORKOS_AUDIENCE=
# Only for a custom auth domain whose key set is not at {api_base}/sso/jwks/{client_id}.
# VESPERS_WORKOS_JWKS_URL_OVERRIDE=
# Dashboard half lives in .env.dashboard (see .env.dashboard.example).
# Spike provider keys belong only in .env.spike (see .env.spike.example); never here.
# VESPERS_ENCRYPTION_KEY=  # Required in production; provision outside source control.
