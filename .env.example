# Local development only. No live provider keys are needed for scaffold checks.
VESPERS_ENVIRONMENT=development
VESPERS_DATABASE_URL=postgresql+psycopg://vespers_app:local_app_only@localhost:5432/vespers_development
VESPERS_DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://vespers_dbos:local_dbos_only@localhost:5432/vespers_dbos_development
VESPERS_LOG_LEVEL=INFO
VESPERS_SIGNUP_ALLOWLIST=[]
VESPERS_SPIKE_GEMINI_API_KEY=
# Explicit model ID from your Developer API account; no model has been verified yet.
VESPERS_SPIKE_GEMINI_MODEL_ID=gemini-3.5-flash-lite
VESPERS_SPIKE_COMPOSIO_API_KEY=
# Separate platform-managed Tavily test key; never reuse Gemini/Composio credentials.
VESPERS_SPIKE_TAVILY_API_KEY=
# Designated synthetic Composio identity for the later spike.
# VESPERS_ENCRYPTION_KEY=  # Required in production; provision outside source control.
