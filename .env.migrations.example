# Migration process only; copy to .env.migrations for HOST development.
# Read by `make migrate` / `uv run alembic upgrade head` running on your machine,
# so it uses the port Compose publishes to the host (compose.yaml: 127.0.0.1:5433),
# not the container-internal 5432. Inside Compose the `migrate` service gets its
# own URL on the internal network and never reads this file.
VESPERS_ENVIRONMENT=development
VESPERS_MIGRATION_DATABASE_URL=postgresql+psycopg://vespers_owner:local_owner_only@127.0.0.1:5433/vespers_development
